# Frontend build-time configuration. Only VITE_-prefixed variables reach the
# browser bundle, so NEVER put secrets here - API keys belong in the backend .env.

# Absolute backend origin for production builds served from a different origin.
# Leave empty (default) to call the backend on the same origin (dev proxy / reverse proxy).
VITE_API_BASE_URL=

# Dev server only (not bundled): where the Vite proxy forwards /api and /ws.
# NEXUS_DEV_BACKEND_URL=http://127.0.0.1:8000
