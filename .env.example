# NEXUS HASH AI backend configuration.
# Copy to `.env` (repo root or backend/) and adjust. `.env` is git-ignored: never commit it.
# Every value is validated at startup; invalid configuration stops the server with a clear message.

NEXUS_ENVIRONMENT=development          # development | test | production

# --- Network binding --------------------------------------------------------
# Loopback only by default. Any other host also requires NEXUS_ALLOW_REMOTE_ACCESS=true.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_ALLOW_REMOTE_ACCESS=false

# --- Logging ------------------------------------------------------------------
NEXUS_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_FORMAT=console               # console | json

# --- HTTP ---------------------------------------------------------------------
# Comma-separated allowlist (also applied to WebSocket Origin checks). Wildcards are rejected.
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Interactive API docs (/docs). Empty = on in development, off in production.
NEXUS_DOCS_ENABLED=
NEXUS_MAX_REQUEST_BODY_BYTES=1048576

# --- Realtime (WebSocket) -----------------------------------------------------
NEXUS_WS_MAX_CONNECTIONS=32
NEXUS_WS_HEARTBEAT_SECONDS=5
NEXUS_WS_CLIENT_QUEUE_SIZE=256
NEXUS_WS_MAX_MESSAGE_BYTES=4096

# --- Secrets (backend only) ---------------------------------------------------
# Optional. Enables NEXUS CORE's LLM mode (Milestone 8). Read only by the backend,
# never sent to the browser, and scrubbed from logs. NEXUS_ANTHROPIC_API_KEY also works.
ANTHROPIC_API_KEY=
